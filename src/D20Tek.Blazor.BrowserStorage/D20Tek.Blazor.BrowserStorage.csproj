<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>D20Tek.Blazor.BrowserStorage</PackageId>
    <Version>1.0.0</Version>
    <Authors>DarthPedro</Authors>
    <Company>D20Tek</Company>
    <Product>D20Tek.Blazor.BrowserStorage</Product>
    <Description>A modern, lightweight .NET library that provides typed, asynchronous access to the browser's localStorage and sessionStorage APIs for Blazor WebAssembly and client-side render modes. Features include result-based reads with StorageResult, key prefix namespacing, bulk operations, change notifications, configurable JSON serialization, and flexible service lifetimes.</Description>
    <PackageTags>blazor;blazor-webassembly;localstorage;sessionstorage;browser storage;wasm;client-side;webstorage;blazored;blazored replacement</PackageTags>
    <PackageProjectUrl>https://github.com/d20Tek/d20tek-blazor-browserstorage</PackageProjectUrl>
    <RepositoryUrl>https://github.com/d20Tek/d20tek-blazor-browserstorage</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with full localStorage and sessionStorage support for Blazor WebAssembly. Includes typed async API, result-based reads, bulk operations, change notifications, key prefixing, and configurable service lifetimes.</PackageReleaseNotes>
    <Copyright>Copyright (c) 2025 D20Tek. All rights reserved.</Copyright>

    <!-- Symbol Package for Debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageIcon>package-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\package-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.JSInterop" />
    <InternalsVisibleTo Include="D20Tek.Blazor.BrowserStorage.Tests" />
  </ItemGroup>

</Project>
