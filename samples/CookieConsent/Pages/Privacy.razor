@page "/privacy"
<PageTitle>Privacy &amp; Cookies</PageTitle>

<h1>Privacy &amp; Cookies</h1>
<p>Review or change your cookie-consent decision at any time.</p>

<div class="card p-4 mt-3" style="max-width: 600px;">
    <h5 class="mb-3">Cookie Categories</h5>

    <div class="mb-3">
        <strong>Essential</strong> - always on. Remembers your consent decision itself.
    </div>

    <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" id="privacy-analytics" @bind="_analytics" />
        <label class="form-check-label" for="privacy-analytics">Analytics cookies</label>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="privacy-marketing" @bind="_marketing" />
        <label class="form-check-label" for="privacy-marketing">Marketing cookies</label>
    </div>

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-accent" @onclick="SavePreferences">Save Preferences</button>
        <button class="btn btn-outline-danger" @onclick="ResetConsent">Reset Consent</button>

        @if (_saved)
        {
            <span class="text-success">Saved!</span>
        }
        @if (_reset)
        {
            <span class="text-warning">Consent reset - the banner will reappear.</span>
        }
    </div>
</div>

@code {
    private bool _analytics;
    private bool _marketing;
    private bool _saved;
    private bool _reset;

    [Inject]
    private ConsentBannerService BannerService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await BannerService.LoadAsync();
        _analytics = BannerService.Current?.Analytics ?? false;
        _marketing = BannerService.Current?.Marketing ?? false;
    }

    private async Task SavePreferences()
    {
        await BannerService.SaveCustomPreferencesAsync(_analytics, _marketing);

        _saved = true;
        await Task.Delay(200);
        _saved = false;
        StateHasChanged();
    }

    private async Task ResetConsent()
    {
        await BannerService.ResetConsentAsync();
        _analytics = false;
        _marketing = false;

        _reset = true;
        await Task.Delay(200);
        _reset = false;
        StateHasChanged();
    }
}
