@page "/quiz/{Category}"

<PageTitle>Quiz - @Category - Tech Trivia</PageTitle>

@if (_questions.Count == 0)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (_currentIndex < _questions.Count)
{
    var question = _questions[_currentIndex];
    var progress = (int)((double)_currentIndex / _questions.Count * 100);

    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="fw-semibold">Question @(_currentIndex + 1) of @_questions.Count</span>
            <span class="badge bg-secondary">@question.Difficulty</span>
        </div>
        <div class="progress" style="height: 8px;">
            <div class="progress-bar" style="width: @(progress)%"></div>
        </div>
    </div>

    <div class="card p-4">
        <h4 class="mb-4">@question.Question</h4>

        <div class="d-grid gap-2">
            @for (var i = 0; i < question.Options.Length; i++)
            {
                var index = i;
                var btnClass = "btn btn-outline-primary text-start";

                if (_answered)
                {
                    if (index == question.CorrectIndex)
                        btnClass = "btn btn-success text-start";
                    else if (index == _selectedAnswer)
                        btnClass = "btn btn-danger text-start";
                    else
                        btnClass = "btn btn-outline-secondary text-start";
                }
                else if (index == _selectedAnswer)
                {
                    btnClass = "btn btn-primary text-start";
                }

                <button class="@btnClass" disabled="@_answered" @onclick="() => SelectAnswer(index)">
                    <strong>@((char)('A' + index)).</strong> @question.Options[index]
                </button>
            }
        </div>

        @if (_selectedAnswer >= 0 && !_answered)
        {
            <button class="btn btn-warning mt-3" @onclick="ConfirmAnswer">Confirm Answer</button>
        }

        @if (_answered)
        {
            <div class="mt-3">
                @if (_selectedAnswer == question.CorrectIndex)
                {
                    <p class="text-success fw-bold">✅ Correct!</p>
                }
                else
                {
                    <p class="text-danger fw-bold">❌ Incorrect. The answer was: @question.Options[question.CorrectIndex]</p>
                }
                <button class="btn btn-primary" @onclick="NextQuestion">
                    @(_currentIndex + 1 < _questions.Count ? "Next Question →" : "See Results →")
                </button>
            </div>
        }
    </div>

    <div class="mt-3 text-muted">
        <small>Score: @_score / @(_currentIndex + (_answered ? 1 : 0)) | Streak: @_streak</small>
    </div>
}
