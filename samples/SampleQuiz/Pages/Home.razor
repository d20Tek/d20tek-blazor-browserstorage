@page "/"

<PageTitle>Home - Tech Trivia</PageTitle>

<div class="text-center mt-4">
    <h1 class="display-4 mb-3">🧠 Tech Trivia</h1>
    <p class="lead text-muted">Test your knowledge of .NET, Azure, and Windows!</p>
</div>

@if (_loading)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status"></div>
    </div>
}
else if (_profile is null)
{
    <div class="card mx-auto mt-4 p-4" style="max-width: 450px;">
        <h4 class="mb-3">Welcome! Enter your name to get started:</h4>
        <div class="mb-3">
            <input class="form-control form-control-lg" placeholder="Your name" @bind="_playerName" @bind:event="oninput" />
        </div>
        <button class="btn btn-primary btn-lg w-100" disabled="@string.IsNullOrWhiteSpace(_playerName)" @onclick="CreateProfile">
            Start Playing
        </button>
    </div>
}
else
{
    <div class="card mx-auto mt-4 p-4" style="max-width: 500px;">
        <h3>Welcome back, @_profile.Name! 👋</h3>
        <p class="text-muted mb-1">Player since @_profile.CreatedDate.LocalDateTime.ToString("MMMM yyyy")</p>
        <p>Games played: <strong>@_gamesPlayed</strong> | Current streak: <strong>@_streak</strong></p>

        <div class="d-flex gap-2 mt-3">
            <a class="btn btn-primary btn-lg flex-grow-1" href="/categories">Play Quiz</a>
            <a class="btn btn-outline-secondary" href="/leaderboard">Leaderboard</a>
        </div>

        <hr />
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted">Storage keys: @_storageCount</small>
            <button class="btn btn-sm btn-outline-danger" @onclick="ResetAll">Reset All Data</button>
        </div>
    </div>
}
